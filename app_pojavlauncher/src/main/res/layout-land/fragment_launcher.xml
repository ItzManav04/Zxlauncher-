<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <!-- LEFT NAVIGATION -->
    <LinearLayout
        android:id="@+id/zx_left_menu"
        android:layout_width="130dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:text="🦅 ZX"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/custom_control_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="📦 Mods"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/install_jar_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="✨ Shaders"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/share_logs_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🧍 Skins"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="⚙ Settings"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/news_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="ℹ Information"/>

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/discord_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="▶ YouTube"/>

    </LinearLayout>


    <!-- CENTER: PROFILES / INSTANCES -->

    <LinearLayout
        android:id="@+id/zx_profiles_area"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintStart_toEndOf="@id/zx_left_menu"
        app:layout_constraintEnd_toStartOf="@id/zx_right_panel"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your Profiles"
            android:textSize="20sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/zx_profile_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Temporary profile cards -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:text="Survival"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:text="SMP"
                    android:textSize="17sp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_marginBottom="8dp"
                    android:gravity="center_vertical"
                    android:padding="15dp"
                    android:text="Modded"
                    android:textSize="17sp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>


    <!-- RIGHT PANEL -->

    <LinearLayout
        android:id="@+id/zx_right_panel"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- PROFILE -->

        <ImageButton
            android:id="@+id/edit_profile_button"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:background="?android:attr/selectableItemBackground"
            android:src="@drawable/ic_edit_profile"
            android:contentDescription="Profile"/>

        <!-- VERSION -->

        <com.kdt.mcgui.mcVersionSpinner
            android:id="@+id/mc_version_spinner"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:layout_marginTop="12dp"
            android:background="@android:color/transparent"
            android:drawableEnd="@drawable/spinner_arrow"
            app:drawableEndPadding="@dimen/_1sdp"
            app:drawableEndSize="@dimen/_12sdp"
            app:drawableStartIntegerScaling="true"
            app:drawableStartSize="@dimen/_36sdp"/>

        <!-- LOADER -->

        <TextView
            android:id="@+id/zx_loader_text"
            android:layout_width="match_parent"
            android:layout_height="45dp"
            android:gravity="center"
            android:text="Fabric / Vanilla / OptiFine"
            android:textSize="13sp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- PLAY -->

        <com.kdt.mcgui.MineButton
            android:id="@+id/play_button"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="@string/main_play"
            android:textAllCaps="true"/>

    </LinearLayout>


    <!-- COSMETIC BACKGROUND -->

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="@color/background_bottom_bar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
